# ===========================================
# SolarNaija Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ===========================================

# ===========================================
# CONTACT FORM
# ===========================================
# Get your access key at https://web3forms.com (free)
# This is required for the contact form to work
VITE_WEB3FORMS_KEY=your_web3forms_access_key_here

# ===========================================
# NEWSLETTER / EMAIL MARKETING
# ===========================================
# Choose one of the following services:

# Option 1: Brevo (formerly Sendinblue) - Recommended
VITE_BREVO_API_URL=https://api.brevo.com/v3/contacts
VITE_BREVO_API_KEY=your_brevo_api_key_here

# Option 2: Mailchimp
VITE_MAILCHIMP_API_URL=your_mailchimp_api_url_here
VITE_MAILCHIMP_API_KEY=your_mailchimp_api_key_here

# Option 3: Supabase (for custom database)
# See Supabase section below

# ===========================================
# ANALYTICS
# ===========================================
# Google Analytics 4 - Get your tracking ID from analytics.google.com
# Format: G-XXXXXXXXXX
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Alternative: Plausible Analytics (privacy-friendly, paid)
# VITE_PLAUSIBLE_DOMAIN=solarnaija.com

# ===========================================
# SUPABASE (Optional - for backend storage)
# ===========================================
# Create a project at https://supabase.com (free tier available)
# Get your project URL and anon key from Settings > API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===========================================
# AFFILIATE PROGRAMS
# ===========================================
# These are your affiliate tracking IDs (not secrets, but keep private)

# Jumia Nigeria Affiliate
VITE_JUMIA_AFFILIATE_ID=your_jumia_affiliate_id

# Konga Affiliate
VITE_KONGA_AFFILIATE_ID=your_konga_affiliate_id

# ===========================================
# SITE CONFIGURATION
# ===========================================
VITE_SITE_URL=https://solarnaija.com
VITE_SITE_NAME=SolarNaija
VITE_SITE_EMAIL=hello@solarnaija.com

# ===========================================
# FEATURE FLAGS (Optional)
# ===========================================
# Enable/disable features without code changes

VITE_ENABLE_NEWSLETTER=true
VITE_ENABLE_ADS=false
VITE_ENABLE_COMMENTS=false
VITE_ENABLE_LIVE_CHAT=false

# ===========================================
# DEVELOPMENT
# ===========================================
# Only used in development mode

VITE_DEBUG=false
VITE_MOCK_API=false
